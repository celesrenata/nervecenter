# nervecenter-env Secret — TEMPLATE ONLY.
#
#   cp secrets.yaml.example secrets.yaml      # secrets.yaml is gitignored
#   <edit secrets.yaml: base64-encode your real values>
#   kubectl -n nervecenter apply -f secrets.yaml
#
# The base values below are coherent PLACEHOLDERS for this cluster's topology
# (postgres/nats/omniroute inside the nervecenter namespace, in-cluster DNS).
# Re-encode after any change:  printf '%s' 'value' | base64
#
# Naming contract: the T104 deploy contract is NERVE_*; the backend currently
# reads NERVECENTER_* (backend/persistence/connection.py, backend/events/
# nats_client.py). Both are set here so the app works before T101 normalizes
# the env-var names — envFrom injects every key below into the api & migrate
# containers.
apiVersion: v1
kind: Secret
metadata:
  name: nervecenter-env
  namespace: nervecenter
  labels:
    app: nervcenter
    app.kubernetes.io/name: env
type: Opaque
data:
  # --- T104 deploy contract (NERVE_*) ---
  # base64 of: postgresql+asyncpg://nervcenter:nervcenter@postgres.nervecenter.svc:5432/nervcenter
  NERVE_DB_URL: "cG9zdGdyZXNxbCthc3luY3BnOi8vbmVydmNlbnRlcjpuZXJ2Y2VudGVyQHBvc3RncmVzLm5lcnZlY2VudGVyLnN2Yzo1NDMyL25lcnZjZW50ZXI="
  # base64 of: nats://nats.nervecenter.svc:4222
  NERVE_NATS_URL: "bmF0czovL25hdHMubmVydmVjZW50ZXIuc3ZjOjQyMjI="
  # base64 of: https://omniroute.nervecenter.svc:8080
  NERVE_OMNIROUTE_URL: "aHR0cHM6Ly9vbW5pcm91dGUubmVydmVjZW50ZXIuc3ZjOjgwODA="
  # base64 of: 1
  NERVE_MOCK_INFER: "MQ=="
  # --- backend runtime names (NERVECENTER_*) ---
  NERVECENTER_DATABASE_URL: "cG9zdGdyZXNxbCthc3luY3BnOi8vbmVydmNlbnRlcjpuZXJ2Y2VudGVyQHBvc3RncmVzLm5lcnZlY2VudGVyLnN2Yzo1NDMyL25lcnZjZW50ZXI="
  NERVECENTER_NATS_URL: "bmF0czovL25hdHMubmVydmVjZW50ZXIuc3ZjOjQyMjI="

  # --- object store (spec §14) — NAMES ONLY, placeholders ---
  # The backend reads these NERVECENTER_* names (backend/storage/config.py).
  # Uncomment and re-encode with real values ONLY once a MinIO/S3 backend is
  # provisioned. When the URL is absent the store degrades honestly to
  # "not configured" (§14) — do NOT set a placeholder URL just to "work".
  #   NERVECENTER_OBJECT_STORE_URL        base64 of: s3://<minio-endpoint>  (required)
  #   NERVECENTER_OBJECT_STORE_BUCKET     base64 of: <bucket>                (required for S3)
  #   NERVECENTER_OBJECT_STORE_ACCESS_KEY base64 of: <access-key-id>         (required for S3)
  #   NERVECENTER_OBJECT_STORE_SECRET_KEY base64 of: <secret-access-key>     (required for S3)
  NERVECENTER_MOCK_INFER: "MQ=="
---
# SSO gate Secret — TEMPLATE ONLY (nervecenter-oauth).
#
# Used by deployments/kubernetes/base/oauth-deployment.yaml (oauth2-proxy) to put
# the public site behind the cluster's Keycloak (realm `celestium`,
# issuer https://sso.celestium.life/realms/celestium). Mirrors the per-app
# `*-oauth` Secret convention (comfyui-oauth: keys client-secret, cookie-secret).
#
#   cp secrets.yaml.example secrets.yaml
#   <fill in the real client-secret from the Keycloak `nervecenter` client>
#   <generate cookie-secret: openssl rand -hex 16   # 32 hex chars = 16 bytes (AES-valid)>
#   kubectl -n nervecenter apply -f secrets.yaml
#
# NEVER commit the real values. The `client-secret` below is a PLACEHOLDER that
# makes the gate's redirect work but the token exchange fail — activate only
# after patching the real value (see the "SSO (Keycloak)" activation runbook in
# deployments/README.md).
apiVersion: v1
kind: Secret
metadata:
  name: nervecenter-oauth
  namespace: nervecenter
  labels:
    app: nervcenter
    app.kubernetes.io/name: nervecenter-oauth
type: Opaque
data:
  # base64 of the PLACEHOLDER below; replace with the Keycloak client secret.
  client-secret: "cGxhY2Vob2xkZXItcmVwbGFjZS13aXRoLWtleWNsb2FrLWNsaWVudC1zZWNyZXQ="
  # base64 of a fresh `openssl rand -hex 16` (gate cookie signing key; 32 hex
  # chars = 16 bytes, the live in-cluster secret matches this length).
  cookie-secret: "REPLACE_WITH_openssl_rand_hex_16"
