# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
nervcenter.egg-info/

# Venv / dev tooling
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Build artifacts
dist/
build/
node_modules/
# SwiftPM build dir (apple package)
.build/

# Local dev state
.deployments-cache/
deployments/local/pgvector-data/
# Local parallel-worker patch artifacts (dev output, may be sensitive)
.patches/

# Gitignored secret manifests (see secrets.yaml.example, harbor-pull.example.yaml)
deployments/kubernetes/base/secrets.yaml
deployments/kubernetes/base/harbor-pull.yaml

# Local env
.env.development.local
.env.staging.local
.env.production.local
.deployments-cache/

# IDE / OS
.idea/
.vscode/
.DS_Store
*.swp
*.swo
*~
web/dist/
apple/.build/

# Apple signing credentials (see apple/Distribution/credentials/README.md)
apple/Distribution/credentials/*
!apple/Distribution/credentials/README.md
apple/Distribution/fastlane/.env
# Local signing key dropped at repo root (rotate it; remove from history)
stabulous.p12

# Apple build state (regenerable; never commit)
apple/.swiftpm/
apple/e2e-artifacts/
apple/Distribution/DerivedData/
*.xcodeproj/**/xcuserdata/

# Per-user Xcode state anywhere under the tree (UserInterfaceState.xcuserstate, xcschememanagement)
**/xcuserdata/
# Spurious nested project duplicates from xcodegen mis-runs (the real projects live at the top level)
apple/Distribution/Generated/NervePhone.xcodeproj/NervePhone.xcodeproj/
apple/Distribution/Generated/NerveWatch.xcodeproj/NerveWatch.xcodeproj/
