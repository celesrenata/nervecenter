# NerveCenter Web — nginx config TEMPLATE (rendered at container start).
#
# Rendered by web/entrypoint.sh via:
#   envsubst '${API_UPSTREAM} ${API_PORT}'
# Only ${API_UPSTREAM} and ${API_PORT} are substituted (scoped list); all
# other nginx runtime variables ($host, $uri, $remote_addr, $scheme,
# $proxy_add_x_forwarded_for) are left intact.
#
#   /            -> static SPA, deep links fall back to /index.html
#   /api/        -> proxied to the api service (FastAPI, :8000)
#   /mcp/        -> proxied to the api service (MCP streamable-HTTP, :8000)

worker_processes auto;
error_log /dev/stderr warn;
pid /var/run/nginx.pid;

events {
  worker_connections 1024;
}

http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  sendfile on;
  keepalive_timeout 65;
  gzip on;
  gzip_vary on;
  gzip_min_length 1024;
  gzip_types text/css application/javascript application/json image/svg+xml;

  # Preserve the scheme the *edge* (Traefik) saw, not this hop's internal
  # scheme. nginx's $scheme is always `http` here (the pod listens on 80),
  # and an unconditional `proxy_set_header X-Forwarded-Proto $scheme` would
  # clobber the edge's `https` — which is how the backend derives its
  # public origin (e.g. the OAuth callback URI) from the request. Fall back
  # to $scheme only when no edge set the header (local dev, no ingress).
  map $http_x_forwarded_proto $public_scheme {
    default $http_x_forwarded_proto;
    ""      $scheme;
  }

  server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
      proxy_pass http://${API_UPSTREAM}:${API_PORT};
      proxy_http_version 1.1;
      proxy_set_header Connection "";
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $public_scheme;
      # SSE/streaming responses: no buffering.
      proxy_buffering off;
      proxy_cache off;
      proxy_read_timeout 300s;
    }

    # Realtime WebSocket endpoint (FastAPI /api/events/ws). Longest-prefix
    # match, so this takes the WS handshake away from the /api/ block above
    # (which sends Connection "" and would break the upgrade).
    location /api/events/ws {
      proxy_pass http://${API_UPSTREAM}:${API_PORT};
      proxy_http_version 1.1;
      # WebSocket upgrade headers.
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection "upgrade";
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $public_scheme;
      # Long-lived: keep idle sockets open past nginx defaults.
      proxy_buffering off;
      proxy_cache off;
      proxy_read_timeout 3600s;
      proxy_send_timeout 3600s;
    }

    location /mcp/ {
      proxy_pass http://${API_UPSTREAM}:${API_PORT};
      proxy_http_version 1.1;
      proxy_set_header Connection "";
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $public_scheme;
      # MCP is streamable-HTTP (long-lived responses): no buffering.
      proxy_buffering off;
      proxy_cache off;
      proxy_request_buffering off;
      proxy_read_timeout 300s;
      chunked_transfer_encoding on;
    }

    # Self-hosted app distribution (ad-hoc, no App Store): static files
    # published under /downloads (NervePhone.ipa, NerveWatch.app,
    # NerveWatchWidgetExtension.watchkitarchive, manifest.json). Built by
    # apple/Distribution/export_app.sh and mounted at runtime (see web/Dockerfile).
    # Long expiry + Last-Modified so unchanged builds are cached client-side.
    location /downloads/ {
      alias /usr/share/nginx/downloads/;
      autoindex on;
      # Artifact installs rarely change; serve strong conditional headers.
      expires 7d;
      add_header Cache-Control "public, max-age=604800";
      # manifest.json is small and JSON; keep it cacheable too.
      # No SPA fallback: a missing artifact must 404, not load index.html.
    }

    location / {
      # SPA: deep links fall back to index.html and the router resolves.
      # The shell must always revalidate (no-cache) so a redeploy's new
      # index.html — referencing new content-hashed /assets/ files — is picked
      # up without a hard refresh. Hashed assets under /assets/ are immutable
      # (see below) and are NOT matched by this location, so they are served
      # with strong caching, not no-cache.
      add_header Cache-Control "no-cache";
      try_files $uri $uri/ /index.html;
    }

    # Content-hashed build artifacts (Vite output /assets/xxx-[hash].js|.css):
    # the filename changes whenever the content changes, so cache
    # aggressively. Longest-prefix match, so this wins over location /.
    location /assets/ {
      add_header Cache-Control "public, max-age=31536000, immutable";
      try_files $uri =404;
    }
  }
}
